# build / output
build/
output.ppm
output.png

# Blender sources and backups (only the exported .glb is tracked)
*.blend
*.blend1
*.blend2

# local tooling / OS
.mcp.json
.claude/
.DS_Store
.vscode/
.idea/
*.code-workspace

# experiment outputs: the linear film (.pfm, 3.7 MB each) is regenerated by run.sh; its SHA-256 is recorded in sha256.txt
experiments/**/*.pfm

# sampler/AA experiment: keep the comparison image and the numbers, not every full-size PNG
experiments/2026-10-15_sampler-aa/*.png
!experiments/2026-10-15_sampler-aa/edges.png

# area-light experiment: keep the comparison image and the numbers, not every full-size PNG
experiments/2026-10-15_area-light-spp/*.png
!experiments/2026-10-15_area-light-spp/shadows.png
