# build / output
build/
output.ppm
output.png

# Blender sources and backups (only the exported .glb is tracked)
*.blend
*.blend1
*.blend2

# local tooling / OS
.mcp.json
.claude/
.DS_Store
.vscode/
.idea/
*.code-workspace

# experiment outputs: the linear film (.pfm, 3.7 MB each) is regenerated by run.sh; its SHA-256 is recorded in sha256.txt
experiments/**/*.pfm

# sampler/AA experiment: keep the comparison image and the numbers, not every full-size PNG
experiments/2026-10-15_sampler-aa/*.png
!experiments/2026-10-15_sampler-aa/edges.png

# area-light experiment: keep the comparison image and the numbers, not every full-size PNG
experiments/2026-10-15_area-light-spp/*.png
!experiments/2026-10-15_area-light-spp/shadows.png

# light-size experiment: keep the comparison image and the numbers, not every full-size PNG
experiments/2026-10-15_light-size-spp/*.png
!experiments/2026-10-15_light-size-spp/size_x_spp.png

# silhouette-fix experiment: keep the comparison image and the numbers, not every full-size PNG
experiments/2026-10-15_silhouette-fix/*.png
!experiments/2026-10-15_silhouette-fix/before_after.png

# Release build used for rendering and timing (build/ may be a Debug build for debugging)
build-release/

# M2 / M3 / M4 experiments: the key images are in docs/screenshots/; run.sh regenerates the rest (and the .pfm films)
experiments/2026-10-15_m2-cornell/*.png
experiments/2026-10-15_m3-progressive/*.png
experiments/2026-10-15_m4-nee/*.png

# M5 / release-timing experiments: the numbers are in results.txt / notes.md, the figures in docs/screenshots/; run.sh regenerates the images
experiments/2026-10-16_m5-accel/*.png
experiments/2026-10-16_m5-threads/*.png
experiments/2026-10-16_release-timings/*.png

# M7 experiments: numbers in results.* / notes.md, figures in docs/screenshots/; run.sh regenerates the images
experiments/2026-10-16_m7-materials/*.png

# Cycles comparison: numbers in results.* / notes.md, figures in docs/screenshots/; run.sh regenerates the images (needs Blender)
experiments/2026-10-16_m7-cycles/*.png
experiments/2026-10-16_m7-cycles/*.exr

# Purchased model (CGTrader), too large / licensed
Assets/bettle/
Scene/Test/Beetle_Room*.glb

# normal-map convention check: generated glb / arrays / probe binary (run.sh regenerates them)
experiments/2026-10-17_normal-map-convention/out/
